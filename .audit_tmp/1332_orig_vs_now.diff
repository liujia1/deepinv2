+# ===== 淇濆瓨鏁板€肩粨鏋?=====
+import json
+
+def _to_native(obj):
+    """閫掑綊杞崲numpy/torch绫诲瀷涓篜ython鍘熺敓绫诲瀷"""
+    import numpy as np
+    if isinstance(obj, dict): return {k: _to_native(v) for k, v in obj.items()}
+    if isinstance(obj, (list, tuple)): return [_to_native(v) for v in obj]
+    if isinstance(obj, (np.integer,)): return int(obj)
+    if isinstance(obj, (np.floating,)): return float(obj)
+    if isinstance(obj, np.ndarray): return _to_native(obj.tolist())
+    try:
+        import torch
+        if isinstance(obj, torch.Tensor): return _to_native(obj.detach().cpu().tolist())
+    except: pass
+    return obj
+
+results_summary = {}
+if HAS_RUN and dps_psnr is not None:
+    results_summary["DPS_PSNR"] = round(float(dps_psnr), 2)
+    results_summary["DiffPIR_PSNR"] = round(float(diffpir_psnr), 2)
+else:
+    results_summary["note"] = "GPU鏈娴嬪埌锛屾湭瀹為檯杩愯"
+results_summary = _to_native(results_summary)
+with open(os.path.join(SAVE_DIR, 'results_summary.json'), 'w', encoding='utf-8') as f:
+    json.dump(results_summary, f, ensure_ascii=False, indent=2)
+print(f"鏁板€肩粨鏋滃凡淇濆瓨: {os.path.join(SAVE_DIR, 'results_summary.json')}")
