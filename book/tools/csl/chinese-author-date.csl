<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0"
       default-locale="zh-CN" demote-non-dropping-particle="never">
  <info>
    <title>中文著者-出版年（GB/T 7714-2015 简化）</title>
    <id>https://gitee.com/mylaujia/txsc/csl/chinese-author-date</id>
    <updated>2026-10-25T00:00:00+00:00</updated>
    <author>
      <name>刘佳</name>
    </author>
  </info>

  <locale xml:lang="zh-CN">
    <terms>
      <term name="et-al">等</term>
      <term name="and">和</term>
      <term name="page-range-delimiter">-</term>
    </terms>
  </locale>

  <!-- 正文短名：家族名，三人以上"等" -->
  <macro name="author-short">
    <names variable="author">
      <name form="short" and="text" delimiter=", " delimiter-precedes-last="never"
            et-al-min="3" et-al-use-first="1" initialize-with=""/>
      <substitute>
        <names variable="editor"/>
        <text variable="title" form="short"/>
      </substitute>
    </names>
  </macro>

  <!-- 文献表全名：姓, 名缩写 -->
  <macro name="author-long">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " delimiter=", "
            delimiter-precedes-last="never"
            et-al-min="4" et-al-use-first="3" initialize-with=". "/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="issued-year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <!-- 文献类型标识：GB/T 7714 的 [M] [J] [C] 等 -->
  <macro name="type-mark">
    <choose>
      <if type="article-journal article-magazine article-newspaper" match="any">
        <text value="[J]"/>
      </if>
      <else-if type="paper-conference" match="any">
        <text value="[C]"/>
      </else-if>
      <else-if type="thesis" match="any">
        <text value="[D]"/>
      </else-if>
      <else-if type="report" match="any">
        <text value="[R]"/>
      </else-if>
      <else-if type="webpage post-weblog" match="any">
        <text value="[EB/OL]"/>
      </else-if>
      <else>
        <text value="[M]"/>
      </else>
    </choose>
  </macro>

  <macro name="secondary">
    <choose>
      <if type="article-journal article-magazine article-newspaper" match="any">
        <group delimiter=", ">
          <text variable="container-title" font-style="italic"/>
          <text macro="issued-year"/>
          <group delimiter=" ">
            <text variable="volume" font-weight="bold"/>
            <text variable="issue" prefix="(" suffix=")"/>
          </group>
          <text variable="page"/>
        </group>
      </if>
      <else-if type="paper-conference" match="any">
        <group delimiter=", ">
          <text variable="container-title"/>
          <text macro="issued-year"/>
          <text variable="page"/>
        </group>
      </else-if>
      <else>
        <group delimiter=": ">
          <text variable="publisher-place"/>
          <text variable="publisher"/>
        </group>
      </else>
    </choose>
  </macro>

  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true"
            disambiguate-add-names="true" collapse="year">
    <sort>
      <key macro="author-short"/>
      <key macro="issued-year"/>
    </sort>
    <layout prefix="（" suffix="）" delimiter="；">
      <group delimiter="，">
        <text macro="author-short"/>
        <text macro="issued-year"/>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="false" entry-spacing="0" line-spacing="1">
    <sort>
      <key macro="author-long"/>
      <key macro="issued-year"/>
    </sort>
    <layout suffix=".">
      <group delimiter=". ">
        <text macro="author-long"/>
        <group delimiter="">
          <text variable="title"/>
          <text macro="type-mark"/>
        </group>
        <text macro="secondary"/>
      </group>
    </layout>
  </bibliography>
</style>
