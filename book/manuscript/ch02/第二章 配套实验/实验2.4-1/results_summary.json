  "psnr_foe_after_10steps_dB": 23.26,
  "psnr_foe_after_50steps_dB": 23.27,
  "posterior_energy": {
    "definition": "0.5*sum((x-y)^2) + lambda*sum_k sum_pix alpha_k log(1+gamma r^2)",
