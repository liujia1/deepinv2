{
  "experiment": "2.4-1 FoE 双层优化与参数学习",
  "device": "cpu",
  "num_epochs": 30,
  "num_experts": 6,
  "kernel_size": 7,
  "gamma": 1.0,
  "lambda_reg": 0.01,
  "noise_level": 0.12,
